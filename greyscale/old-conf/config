{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    // "height": 20, // Waybar height (to be removed for auto height)
    "margin": "5 10 0 10",
        // Choose the order of the modules
        "modules-left": ["custom/operatingSystem", "hyprland/workspaces"],
        "modules-center": ["hyprland/window"],
        "modules-right": ["network", "pulseaudio", "battery", "clock", "custom/powerOff"],


        //***************************
        //*  Modules configuration  *
        //***************************

    "hyprland/window" : {
        "format" : "{}",
        "icon" : true,
        "max-length": 15 
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "persistent-workspaces": {
            "*": 1,
        },
        "active-only": false,
        "format": ""
    },    

    "pulseaudio" : {
       "format" : "  {volume}",
       "format-muted": "󰖁",
       "format-icons" : {
        "muted" : "󰖁",
        "high" : "",
        "low" : ""
       },
       "on-click" : "amixer set Master toggle",
       "tooltip-format": "{desc}: {volume}"
	},

	"network" : {
		"format-wifi" : " ",
        "tooltip-format-wifi": "{essid}, {ipaddr}/{cidr}",
		"format-ethernet" : "{ipaddr}/{cidr}",
		"format-disconnected" : " ",
        "on-click": "nm-applet --indicator"
	},
        
    "battery" : {
	    "format": "󰁹 {capacity}%",
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M}"
    },

    "custom/powerOff": {
        "format": "",
        "on-click": "shutdown now",
        "tooltip-format": "turn off"
    },

    "custom/operatingSystem": {
        "format": "",
        "on-click": "kitty neofetch",
        "tooltip-format": "NixOS"
    }

}
